# SharedCompute provider-agent settings for THIS machine.
# Lives outside Git at ~/.config/sharedcompute/agent.env (scripts/bootstrap-agent.sh creates it, mode 600).
# Real environment variables and command-line flags override this file.

# Marketplace URL. Must be https:// unless the marketplace runs on this same machine.
SHAREDCOMPUTE_SERVER=http://127.0.0.1:8765

# File holding the node token from the marketplace's Provide page (chmod 600). Never put the token itself here.
SHAREDCOMPUTE_TOKEN_FILE=~/.config/sharedcompute/node.token

# Trust a private CA / self-signed marketplace certificate (scripts/make-dev-tls.sh). Leave empty for public
# certificates (Let's Encrypt, Tailscale).
SHAREDCOMPUTE_CA_FILE=

# WHICH DEVICES TO OFFER. Nothing is offered unless you choose it here or with flags.
# GPUs by nvidia-smi index or UUID prefix, comma-separated, e.g. 1  or  GPU-3f2a
SHAREDCOMPUTE_GPUS=
# Offer this machine's CPU for CPU workloads (1 = yes).
SHAREDCOMPUTE_OFFER_CPU=0
# Allow offering a GPU that drives a monitor. Leave 0 unless you accept desktop slowdowns or freezes.
SHAREDCOMPUTE_ALLOW_DISPLAY_GPU=0
# If CUDA fails, run GPU workloads on the CPU instead. Reported as CPU work and never billed as GPU.
SHAREDCOMPUTE_ALLOW_CPU_FALLBACK=0
