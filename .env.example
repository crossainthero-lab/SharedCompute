# SharedCompute marketplace settings for THIS machine.
# Copy to .env (git-ignored): `cp .env.example .env`. scripts/bootstrap-dev.sh does this for you.
# Real environment variables override this file. Never put secrets you can't rotate in here.

# Where the SQLite database lives (git-ignored data/ by default).
SHAREDCOMPUTE_DB=data/sharedcompute.sqlite3

# Economics: marketplace fee in basis points (1000 = 10% fee, 90% to providers).
SHAREDCOMPUTE_PLATFORM_FEE_BPS=1000

# Local development conveniences. All of these are simulated: no money moves.
SHAREDCOMPUTE_SEED_SAMPLES=1
SHAREDCOMPUTE_DEMO_CREDITS=1
SHAREDCOMPUTE_SIMULATION_SECONDS=8
# Let your own jobs run on your own devices (needed to test a provider alone; turn off for real money).
SHAREDCOMPUTE_ALLOW_SELF_MATCH=1

# Exposure. `serve` binds 127.0.0.1 by default. When served beyond loopback (--host with TLS, or
# --behind-tls-proxy) these default to closed; only uncomment to deliberately reopen them.
# SHAREDCOMPUTE_REGISTRATION=closed
# SHAREDCOMPUTE_PUBLIC_MARKETPLACE=0
# SHAREDCOMPUTE_API_DOCS=0
# SHAREDCOMPUTE_TRUSTED_PROXIES=127.0.0.1
